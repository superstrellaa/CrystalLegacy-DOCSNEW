  "keyFeatures": [
    "Four custom spells: Dash, Bola de Fuego, Levioso, Hachazo",
    "Automated multi-step tutorial sequence with per-player slot assignment",
    "Parkour mini-event with checkpoints and a 10-minute countdown",
    "Single-elimination PVP tournament bracket with auto-generated bracket image",
    "State-driven event flow (DEV → WAITING_PLAYERS → TUTORIAL → MINI_EVENTS → PVP)",
    "Custom HUD showing spell cooldowns and keybinds",
    "Integrated Simple Voice Chat control per event state",
    "Admin /master command suite for full event control",
    "Custom music playlists per event phase",
    "Client mid-state join auto-sync"
  ],
  "publicApiSurface": [
    "/master estado ;state;",
    "/master data clear [all|bracket|client|parkour|pvp|timer|torneo|tutorial|voicechat]",
    "/master hechizo ;bloquear/desbloquear; ;spell; ;player(s);",
